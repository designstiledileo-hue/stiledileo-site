function esc(v: unknown = "") { return String(v).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]!)); }
function imageUrl(v?: string | null) { if (!v) return ""; return /^https?:\/\//.test(v) ? v : `${CDN}/${v.replace(/^\//, "")}`; }
function apiKey() { const key = Netlify.env.get("OPINLY_API_KEY"); if (!key) throw new Error("OPINLY_API_KEY is not configured"); return key; }
async function opinly(path: string) {
  const r = await fetch(`${API}${path}`, { headers: { Authorization: `Bearer ${apiKey()}` } });
  if (r.status === 404) return null;
  if (!r.ok) throw new Error(`Opinly ${r.status}: ${await r.text()}`);
  return r.json();
}
function marks(text: string, ms: any[] = []) { return ms.reduce((s,m) => m.type === "bold" ? `<strong>${s}</strong>` : m.type === "italic" ? `<em>${s}</em>` : m.type === "code" ? `<code>${s}</code>` : m.type === "link" ? `<a href="${esc(m.attrs?.href)}" rel="${m.attrs?.target === "_blank" ? "noopener noreferrer" : ""}">${s}</a>` : s, esc(text)); }
function renderNode(n: any): string {
  if (!n) return ""; const kids = () => (n.content || []).map(renderNode).join("");
  switch(n.type) {
    case "doc": return kids(); case "text": return marks(n.text || "", n.marks); case "paragraph": return `<p>${kids()}</p>`;
    case "heading": { const l=Math.min(6,Math.max(2,Number(n.attrs?.level)||2)); return `<h${l}>${kids()}</h${l}>`; }
    case "bulletList": return `<ul>${kids()}</ul>`; case "orderedList": return `<ol>${kids()}</ol>`; case "listItem": return `<li>${kids()}</li>`;
