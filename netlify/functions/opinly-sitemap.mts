function e(v:string){return v.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");}
function mapRoute(r:any){switch(r.type){case"post":return`/blog/${r.slug}`;case"category":return`/blog/category/${r.slug}`;case"author":return`/blog/authors/${r.slug}`;case"tag":return`/blog/tag/${r.slug}`;case"home":return"/blog";default:return null}}
export default async()=>{try{const key=Netlify.env.get("OPINLY_API_KEY");if(!key)throw new Error("missing key");const r=await fetch(`${API}/routes`,{headers:{Authorization:`Bearer ${key}`}});if(!r.ok)throw new Error(`Opinly ${r.status}`);const raw=await r.json();const routes=Array.isArray(raw)?raw:raw.data||[];const seen=new Set<string>();const rows:string[]=[];for(const p of existing){seen.add(p);rows.push(`<url><loc>${e(SITE+p)}</loc></url>`)}for(const item of routes){const p=mapRoute(item);if(!p||seen.has(p))continue;seen.add(p);rows.push(`<url><loc>${e(SITE+p)}</loc>${item.lastModified?`<lastmod>${e(item.lastModified)}</lastmod>`:""}</url>`)}const xml=`<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">${rows.join("")}</urlset>`;return new Response(xml,{headers:{"content-type":"application/xml; charset=utf-8","cache-control":"public, s-maxage=900"}})}catch(err){console.error(err);return new Response("Sitemap temporarily unavailable",{status:502})}};
