const API="https://sdk.opinly.ai/v1/content"; const SITE="https://stiledileo.com";
function x(v:unknown=""){return String(v).replace(/[<>&"']/g,c=>({"<":"&lt;",">":"&gt;","&":"&amp;",'"':"&quot;","'":"&apos;"}[c]!));}
export default async()=>{try{const key=Netlify.env.get("OPINLY_API_KEY");if(!key)throw new Error("missing key");const r=await fetch(`${API}/rss?limit=20`,{headers:{Authorization:`Bearer ${key}`}});if(!r.ok)throw new Error(`Opinly ${r.status}`);const data=await r.json();const items=(Array.isArray(data)?data:data.data||data.items||[]).map((p:any)=>`<item><title>${x(p.title)}</title><link>${SITE}/blog/${x(p.slug)}</link><guid isPermaLink="true">${SITE}/blog/${x(p.slug)}</guid><description>${x(p.description||"")}</description><pubDate>${new Date(p.firstPublishedAt||p.publishedAt||p.date).toUTCString()}</pubDate></item>`).join("");const xml=`<?xml version="1.0" encoding="UTF-8"?><rss version="2.0"><channel><title>Stile di Leo Journal</title><link>${SITE}/blog</link><description>Architectural finishes, Venetian plaster, Marmorino and fireplace design in Metro Vancouver.</description>${items}</channel></rss>`;return new Response(xml,{headers:{"content-type":"application/rss+xml; charset=utf-8","cache-control":"public, s-maxage=900"}})}catch(e){console.error(e);return new Response("RSS temporarily unavailable",{status:502})}};
export const config={path:"/rss.xml"};